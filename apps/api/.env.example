# Copy to .env and adjust. All settings take the GRAPHRAG_ prefix.
GRAPHRAG_ENVIRONMENT=development

# Serve fixture data instead of calling AWS. Set false once Sprint 2 lands.
GRAPHRAG_USE_FIXTURES=true

# Sprint 2 — real retrieval.
GRAPHRAG_AWS_REGION=us-east-1
GRAPHRAG_BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
# GRAPHRAG_NEPTUNE_ENDPOINT=wss://your-cluster.neptune.amazonaws.com:8182/gremlin
