# Copy to .env or .env.local and adjust. Both are read, .env.local last so it
# wins — same convention as the web app. Both are gitignored.
#
# Settings take the RAGSTONE_ prefix; provider keys use their own names so an
# existing shell environment works untouched.
RAGSTONE_ENVIRONMENT=development

RAGSTONE_USE_FIXTURES=true

RAGSTONE_AWS_REGION=us-east-1
RAGSTONE_BEDROCK_MODEL_ID=anthropic.claude-sonnet-5

# --- graph backends ---
# A request names a backend; it can never supply an endpoint. Endpoints are
# configured here, and a backend is only offered when it could actually answer.
#
# openCypher over Bolt. The local store and a managed Neptune cluster both
# speak it, so only the URI changes:
#
#   docker compose up -d neo4j
#   pnpm --filter @ragstone/api seed
#
# Install the extra first: pip install -e ".[graph]"
# Aliased to the driver's own variable names, so every Neo4j tool reads the
# same values this service does.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragstone-dev

# SPARQL. Adapter not wired yet.
# RAGSTONE_NEPTUNE_ENDPOINT=https://your-cluster.neptune.amazonaws.com:8182/sparql

# --- answer generation ---
# Without a key the service answers from fixtures, so the demo works with
# nothing configured. Provide a key and it answers with a model.
# Install the extra first: pip install -e ".[llm]"

# anthropic | openai | bedrock
RAGSTONE_LLM_PROVIDER=anthropic

# Full litellm model id. Empty uses the provider's default
# (anthropic/claude-opus-5, openai/gpt-5).
# RAGSTONE_LLM_MODEL=anthropic/claude-opus-5

# Keys are read from the provider's own variable, so an existing shell
# environment works untouched. Never commit these — .env is gitignored.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Overrides the provider variable above when set.
# RAGSTONE_LLM_API_KEY=

# Covers reasoning *and* the answer on reasoning models. Set it too low and the
# model can spend the whole budget thinking and return no text — the service
# reports that rather than showing an empty answer, but the fix is more budget.
# RAGSTONE_ANSWER_MAX_TOKENS=4096
# RAGSTONE_LLM_TIMEOUT=60

# Left unset on purpose: the Claude 5 family rejects temperature with a 400.
# RAGSTONE_LLM_TEMPERATURE=0.2
