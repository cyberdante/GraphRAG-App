# Copy to .env and adjust. All settings take the RAGSTONE_ prefix.
RAGSTONE_ENVIRONMENT=development

# Serve fixture data instead of calling AWS. Set false once Sprint 2 lands.
RAGSTONE_USE_FIXTURES=true

# Sprint 2 — real retrieval.
RAGSTONE_AWS_REGION=us-east-1
RAGSTONE_BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
# RAGSTONE_NEPTUNE_ENDPOINT=wss://your-cluster.neptune.amazonaws.com:8182/gremlin
