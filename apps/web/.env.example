# Copy to .env.local and adjust. Only VITE_-prefixed vars reach the browser.

# --- tenant ---
# Which brand this deployment wears when the URL does not say. The document is
# fetched at boot, so one build serves every client.
# VITE_TENANT=meridian

# Where tenant documents live. Defaults to /tenants, served from public/.
# Point it at a CDN or a config service in production.
# VITE_TENANT_BASE_URL=https://config.example.com/tenants

# Show the brand switcher. On in development, off everywhere else unless set.
# A client's own deployment must never list other people's brands, so this is
# for the public demo only.
# VITE_TENANT_SWITCHER=true

# --- api ---
# Run without the Python service, using the in-browser fixtures.
# VITE_USE_MOCK=true

# Where the API lives in production. Empty in development, because Vite
# proxies /api to the service for you.
# VITE_API_BASE_URL=https://api.example.com

# Override the dev proxy target if the service runs somewhere else.
# VITE_API_TARGET=http://127.0.0.1:8000
