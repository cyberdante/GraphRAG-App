{
  "name": "ragstone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @ragstone/web dev",
    "dev:api": "pnpm --filter @ragstone/api dev",
    "build": "pnpm --filter @ragstone/web build",
    "preview": "pnpm --filter @ragstone/web preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:web": "pnpm --filter @ragstone/web test",
    "test:api": "pnpm --filter @ragstone/api test",
    "lint": "pnpm --filter @ragstone/api lint",
    "api:setup": "pnpm --filter @ragstone/api setup"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
