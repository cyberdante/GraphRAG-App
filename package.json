{
  "name": "graphrag",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @graphrag/web dev",
    "dev:api": "pnpm --filter @graphrag/api dev",
    "build": "pnpm --filter @graphrag/web build",
    "preview": "pnpm --filter @graphrag/web preview",
    "typecheck": "pnpm -r typecheck",
    "api:setup": "pnpm --filter @graphrag/api setup"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
